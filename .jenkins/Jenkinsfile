
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_RC',
            defaultValue: false,
            description: 'Deploy the tested ZIP to local RuneScape Developer Beta'
        )
        booleanParam(
            name: 'PUBLISH_MODIO',
            defaultValue: false,
            description: 'Submit this version to mod.io after manual approval'
        )
        booleanParam(
            name: 'CONFIRM_NO_MODERATION_FREEZE',
            defaultValue: false,
            description: 'Confirm Jagex has NOT asked you to freeze mod.io submissions'
        )
        string(
            name: 'MODIO_GAME_ID',
            defaultValue: '',
            description: 'Numerical mod.io RuneScape game ID'
        )
        string(
            name: 'MODIO_MOD_ID',
            defaultValue: '',
            description: 'Numerical mod.io listing ID for AFK Vitals Tint'
        )
        text(
            name: 'RELEASE_CHANGELOG',
            defaultValue: '',
            description: 'Describe changes since the previous approved release'
        )
    }

    stages {
        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Validate Project Structure') {
            steps {
                sh '''
                    set -eu
                    test -f src/main.lua
                    test -f src/plugin.json
                    test -f src/logic.lua
                    test -f src/settings.lua
                    test -f src/settings_ui.lua
                    test -f tests/test_logic.lua
                    echo "Required project files found."
                '''
            }
        }

        stage('Continuous Integration') {
            steps {
                sh 'bash .jenkins/scripts/ci.sh'
            }
        }

        stage('Package Plugin') {
            steps {
                sh 'bash .jenkins/scripts/package.sh'
                sh 'test -s dist/afk-vitals-tint.zip'

                archiveArtifacts(
                    artifacts: 'dist/afk-vitals-tint.zip',
                    fingerprint: true
                )
            }
        }

        stage('Deploy to Developer Beta') {
            when {
                expression { params.DEPLOY_RC }
            }
            steps {
                sh 'bash .jenkins/scripts/deploy-rc.sh'
            }
        }

        stage('Submit to mod.io') {
            when {
                expression { params.PUBLISH_MODIO }
            }

            steps {
                script {
                    if (env.BRANCH_NAME != 'master') {
                        error('mod.io submission is restricted to master.')
                    }

                    if (!params.CONFIRM_NO_MODERATION_FREEZE) {
                        error('Confirm that no Jagex moderation freeze is active.')
                    }

                    if (!params.RELEASE_CHANGELOG?.trim()) {
                        error('A release changelog is required.')
                    }

                    if (!(params.MODIO_GAME_ID ==~ /[0-9]+/) ||
                        !(params.MODIO_MOD_ID ==~ /[0-9]+/)) {
                        error('Set the numerical mod.io game and listing IDs.')
                    }

                    def version = sh(
                        script: '''python3 -c 'import json; print(json.load(open("src/plugin.json"))["version"])' ''',
                        returnStdout: true
                    ).trim()

                    input(
                        message: "Submit AFK Vitals Tint v${version} to mod.io for moderation?",
                        ok: 'Submit this version'
                    )
                }

                withCredentials([
                    string(
                        credentialsId: 'modio-oauth-token',
                        variable: 'MODIO_TOKEN'
                    )
                ]) {
                    withEnv([
                        "MODIO_GAME_ID=${params.MODIO_GAME_ID}",
                        "MODIO_MOD_ID=${params.MODIO_MOD_ID}",
                        "RELEASE_CHANGELOG=${params.RELEASE_CHANGELOG}",
                        'MODIO_UPLOAD_CONFIRM=YES'
                    ]) {
                        sh 'bash .jenkins/scripts/deploy-modio.sh'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the console output.'
        }
    }
}
